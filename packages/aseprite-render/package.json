{
  "name": "@papercut/aseprite-render",
  "private": true,
  "version": "0.0.0",
  "description": "Render a frame of a parsed Aseprite file to RGBA pixels, with Aseprite's own blend modes, opacity, groups, z-indexes and tilemaps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@papercut/aseprite": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
