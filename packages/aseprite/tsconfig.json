{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Built as if published (decision-log 2026-09-19): no DOM and no Node, so
    // the same parser runs in a browser, in Node and in a worker. The one
    // dependency is fflate, for the zlib streams inside cels and tilesets.
    "types": []
  },
  // `src/testing/` holds the byte writer the tests build files with; it is not
  // part of the published surface.
  "exclude": ["src/**/*.test.ts", "src/testing/**"],
  "include": ["src"]
}
