{
  "compilerOptions": {
    "target": "ES2022",
    // No `DOM`: the headless claim (#3, #48) is that this app never reaches
    // for a browser global, and with `DOM` out of `lib` the compiler is what
    // says so, not a grep of the finished bundle. `@papercut/runtime` made
    // the same call for the same reason once #47 gave it a canvas-free path;
    // this app is the other half of that claim, the one that actually runs
    // under plain `node`.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // The one package here that WANTS Node's globals: unlike `runtime` or
    // `fixtures`, which stay portable by leaving `types` empty, this app's
    // entire job is to run under `node` — reading argv, the filesystem, and
    // `process.exitCode`. Declaring `@types/node` is the honest version of
    // that, not a leak to grep for.
    "types": ["node"]
  },

  // `references` (#46), matching `apps/editor` — see that config for why an
  // app carries them but is not referenced back by the root solution. This
  // app's `vite build` still resolves `document`, `fixtures`, `geometry` and `runtime`
  // through the `exports` map's `default` condition, so `dist/cli.js` really
  // is assembled from their built output.
  "include": ["src", "vite.config.ts"],

  "references": [
    { "path": "../../packages/document" },
    { "path": "../../packages/fixtures" },
    { "path": "../../packages/geometry" },
    { "path": "../../packages/project" },
    { "path": "../../packages/runtime" }
  ]
}
